# Skopiuj do .env i uzupełnij.

# Lokalny folder, gdzie lądują zdjęcia odebrane po Bluetooth i raport HTML.
LOCAL_PHOTOS_DIR=./photos

# Wyłącz analizę AI (1 = całość offline, tylko odbiór + galeria bez ocen AI).
DISABLE_AI=0

# --- poniższe potrzebne TYLKO gdy DISABLE_AI=0 (analiza Claude woła internet) ---
# Klucz API Anthropic (https://console.anthropic.com/).
ANTHROPIC_API_KEY=sk-ant-...
# Model wizyjny.
ANTHROPIC_MODEL=claude-opus-4-8
