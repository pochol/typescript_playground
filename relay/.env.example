# Skopiuj do .env i uzupełnij.

# Klucz API Anthropic (https://console.anthropic.com/) — do analizy zdjęć.
ANTHROPIC_API_KEY=sk-ant-...

# Model wizyjny.
ANTHROPIC_MODEL=claude-opus-4-8

# Ścieżka do pliku service-account JSON z Firebase (Project settings → Service accounts).
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# Bucket Firebase Storage, np. moj-projekt.appspot.com
FIREBASE_STORAGE_BUCKET=twoj-projekt.appspot.com

# Folder na telefonie, z którego ściągamy (app-specific external storage).
PHONE_PHOTOS_DIR=/sdcard/Android/data/com.mushroom.monitor/files/Pictures/growkit

# Lokalny folder, gdzie lądują ściągnięte zdjęcia.
LOCAL_PHOTOS_DIR=./photos

# Co ile sekund sprawdzać telefon w poszukiwaniu nowych zdjęć.
POLL_INTERVAL_SECONDS=120

# Wyłącz analizę AI (1 = tylko ściągaj i wysyłaj, bez Claude).
DISABLE_AI=0
